{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/Azure/azure-dev/main/cli/azd/extensions/azure.ai.evaluation/schemas/evaluation.schema.json",
  "title": "Microsoft Foundry model evaluation configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "name",
    "dataset",
    "target",
    "evaluators"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "string",
      "description": "Informational profile name such as starter, deterministic, quality, rag, or safety."
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "format",
        "name",
        "version",
        "fields"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "const": "jsonl"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "query",
            "groundTruth"
          ],
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1
            },
            "groundTruth": {
              "type": "string",
              "minLength": 1
            },
            "context": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "sampling": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "topP": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "maxCompletionTokens": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string"
        }
      }
    },
    "evaluators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "id"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "threshold": {
            "type": "number"
          },
          "direction": {
            "type": "string",
            "enum": [
              "increase",
              "decrease"
            ]
          },
          "dataMapping": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    "qualityGate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enforce": {
          "type": "boolean"
        },
        "minPassRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maxErrorRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "remote": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "pollSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "noWait": {
          "type": "boolean"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
